{
  "name": "dbflow",
  "description": "Turn raw CSV files into normalized database schemas \u2014 ERDs, SQL DDL and normalization reports. Local-first desktop app: a Rust engine (native in Tauri, WebAssembly in the browser) with a React UI.",
  "keywords": [
    "erd",
    "entity-relationship-diagram",
    "database-normalization",
    "csv-to-sql",
    "functional-dependencies",
    "3nf",
    "sql-generator",
    "mermaid",
    "tauri",
    "react",
    "rust",
    "webassembly"
  ],
  "license": "MIT",
  "private": true,
  "version": "6.5.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskatul-anwar/dbflow.git"
  },
  "homepage": "https://github.com/miskatul-anwar/dbflow#readme",
  "bugs": {
    "url": "https://github.com/miskatul-anwar/dbflow/issues"
  },
  "author": "Miskatul Anwar <miskatul.anwar.csecu@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "predev": "node scripts/build-engine.mjs && node scripts/prepare-nl-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-engine.mjs && node scripts/prepare-nl-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit --pretty",
    "cli": "tsx scripts/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:nl": "tsx scripts/bench-nl.ts",
    "lint": "eslint . --max-warnings 175",
    "pretest": "node scripts/build-engine.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "fmt:rust": "cargo fmt --all",
    "test:rust": "cargo test --workspace",
    "audit:a11y": "node scripts/a11y-audit.cjs",
    "quality": "bun run build:engine && bun run typecheck && bun run lint && vitest run && cargo test --workspace && bun audit --prod --audit-level=high",
    "audit:ui": "node scripts/ui-audit.cjs",
    "audit:design": "node scripts/consistency-audit.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@huggingface/transformers": "^4.3.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "github-markdown-css": "^5.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
